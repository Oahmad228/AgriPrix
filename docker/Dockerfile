# syntax=docker/dockerfile:1
# One image per service (ADR-008, Sprint 4): each installs only its own subset of
# requirements.lock (requirements/<service>.lock, generated by tools/split_lock.py).
#   target "service" + LOCK=requirements/api.lock        -> agriprix-api
#   target "service" + LOCK=requirements/dashboard.lock  -> agriprix-dashboard
#   target "service" + LOCK=requirements/mlflow.lock     -> agriprix-mlflow
#   target "service" + LOCK=requirements/jobs.lock       -> agriprix-jobs (ETL, training, scheduler)
#   target "dev"     + LOCK=requirements.lock            -> agriprix-dev (tests, lint, everything)
FROM python:3.11.18-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# libgomp1: LightGBM OpenMP runtime; curl: healthchecks; git: MLflow records the commit.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 agriprix && \
    useradd --uid 1000 --gid agriprix --shell /bin/bash --create-home agriprix && \
    mkdir -p /mlflow/artifacts /app/data/raw /app/data/processed /app/data/reports && \
    chown -R agriprix:agriprix /app /mlflow

FROM base AS service
ARG LOCK=requirements.lock
# 1) Pinned third-party dependencies: --no-deps installs exactly the lock, pip check fails
#    the build if the subset is incomplete. The cache mount shares downloads between the
#    service builds without keeping them in any image.
COPY ${LOCK} /tmp/requirements.lock
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --prefer-binary --default-timeout=180 --retries=10 --no-deps \
        -r /tmp/requirements.lock && \
    pip check
# 2) Project code (changes often: last layers).
COPY --chown=agriprix:agriprix pyproject.toml README.md ./
COPY --chown=agriprix:agriprix src ./src
RUN pip install --no-deps -e .
USER agriprix

FROM service AS dev
COPY --chown=agriprix:agriprix tests ./tests
