# Entry point inside the Hugging Face Space. HF terminates HTTPS in front of the container,
# so Caddy listens on plain HTTP :7860 and only routes and hardens.
#
# Visitor address for the API rate limiter: the HF front proxy appends the real client
# address to X-Forwarded-For. Caddy trusts only private-range hops and, in strict mode,
# reads the header right to left, so an address forged by the visitor (on the left) is
# ignored. Caddy then replaces X-Forwarded-For with that single address.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
		trusted_proxies_strict
	}
}

:7860 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The Space page on huggingface.co shows the app in an iframe: allow only that parent.
		Content-Security-Policy "frame-ancestors 'self' https://huggingface.co"
		-Server
	}

	@api path /api/* /docs /docs/* /redoc /openapi.json
	handle @api {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8501
	}
}
