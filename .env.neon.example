# Copy to .env.neon (ignored by Git) and fill in. Used only from your PC to set up Neon
# (deploy/neon/init.sh) and to load the first campaign. Never commit the real file.

# Neon console -> Connect: host (ep-....neon.tech) and the owner role created with the project.
NEON_HOST=ep-xxxx.region.aws.neon.tech
NEON_OWNER_USER=neondb_owner
NEON_OWNER_PASSWORD=change-me

# Roles created by deploy/neon/init.sh. Generate each password with: openssl rand -hex 24
DW_WRITER_USER=agriprix_etl_writer
DW_WRITER_PASSWORD=change-me
DW_READONLY_USER=agriprix_api_readonly
DW_READONLY_PASSWORD=change-me

# Read by the application (src/config.py) when it runs against Neon.
POSTGRES_HOST=ep-xxxx.region.aws.neon.tech
POSTGRES_SSLMODE=require
