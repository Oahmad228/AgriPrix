# =============================================================================
# AgriPrix Observatory — Example Environment Configuration (.env.example)
# Copy to .env if you want to customize local settings: cp .env.example .env
# docker-compose.yml also provides safe fallback defaults so `docker compose up`
# works immediately after cloning.
# =============================================================================

# --- Environment & Application ---
APP_ENV=development
LOG_LEVEL=INFO
GIT_SHA=dev-local

# --- PostgreSQL Superuser (Used ONLY by container entrypoint init script) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=agriprix_super_local_dev

# --- Database 1: Data Warehouse (agriprix_dw) ---
DW_DB=agriprix_dw

# Role 1A: Read-Write ETL & ML Trainer (Used ONLY by job-runner container)
DW_WRITER_USER=agriprix_etl_writer
DW_WRITER_PASSWORD=agriprix_writer_local_dev

# Role 1B: Read-Only API & BI (Used by FastAPI and optional Metabase)
DW_READONLY_USER=agriprix_api_readonly
DW_READONLY_PASSWORD=agriprix_readonly_local_dev

# --- Database 2: MLflow Tracking Backend (mlflow_db — Isolated from DW) ---
MLFLOW_DB=mlflow_db
MLFLOW_DB_USER=mlflow_user
MLFLOW_DB_PASSWORD=agriprix_mlflow_local_dev
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- FastAPI Service Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=60/minute
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://dashboard:8501
ENABLE_CURRENCY_CONVERSION=false

# --- Streamlit Dashboard Configuration ---
STREAMLIT_PORT=8501
API_BASE_URL=http://api:8000
