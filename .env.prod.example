# =============================================================================
# Production secrets for the public demo. Copy to .env ON THE SERVER ONLY:
#   cp .env.prod.example .env && nano .env      (never commit .env)
# Generate each password with:   openssl rand -base64 24
# =============================================================================
DOMAIN=agriprix.duckdns.org          # your DuckDNS subdomain
ACME_EMAIL=you@example.org           # Let's Encrypt expiry notices

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me

DW_DB=agriprix_dw
DW_WRITER_USER=agriprix_etl_writer
DW_WRITER_PASSWORD=change-me
DW_READONLY_USER=agriprix_api_readonly
DW_READONLY_PASSWORD=change-me

MLFLOW_DB=mlflow_db
MLFLOW_DB_USER=mlflow_user
MLFLOW_DB_PASSWORD=change-me

API_RATE_LIMIT=60/minute
REFRESH_DAY=20                       # monthly refresh: day of month (UTC)
REFRESH_HOUR=3
